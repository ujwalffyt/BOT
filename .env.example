# Discord Developer Portal bot token (keep private).
DISCORD_BOT_TOKEN=PASTE_DISCORD_BOT_TOKEN_HERE

# Your Discord numeric user ID(s), comma-separated. These users can administer hosting.
ADMIN_IDS=123456789
# Optional channel for new order notifications; 0 uses admin DMs.
ADMIN_CHANNEL_ID=0
# Optional test server ID for immediate slash-command sync; 0 syncs globally.
DISCORD_GUILD_ID=0

# Public IPv4 address or hostname used for direct website links.
PUBLIC_HOST=YOUR_SERVER_IP
# Optional domain for automatic website HTTPS; wildcard DNS must point to PUBLIC_HOST.
WEB_ROOT_DOMAIN=

# Sample reserves for a 32 GB VPS. Adjust based on real workloads and other services.
HOST_RESERVED_RAM_MB=6144
MIN_FREE_RAM_MB=2048
HOST_RESERVED_CPU_CORES=1.0

# Per-container caps, not dedicated CPU cores.
MAX_INSTANCE_RAM_MB=8192
MAX_INSTANCE_CPU_CORES=4.0
VPS_RAM_MB=2048
VPS_CPU_CORES=1.0
WEB_RAM_MB=1024
WEB_CPU_CORES=1.0

# Direct HTTP ports are used for websites only when WEB_ROOT_DOMAIN is blank.
WEB_PORT_START=8000
WEB_PORT_END=8999

# SSHX VPS access is an outbound browser session inside the isolated container.
# No inbound SSH port or customer public key is needed.
DB_PATH=/app/data/hosting.sqlite3
WORK_DIR=/app/work
SITES_DIR=/app/caddy/sites
LOG_LEVEL=INFO
