# Discord Developer Portal bot token (keep private).
DISCORD_BOT_TOKEN=PASTE_DISCORD_BOT_TOKEN_HERE

# Your Discord numeric user ID(s), comma-separated. These users can approve and manage instances.
ADMIN_IDS=123456789
# Optional channel for new order notifications; 0 uses admin DMs.
ADMIN_CHANNEL_ID=0
# Optional test server ID for near-instant slash-command sync; 0 syncs globally.
DISCORD_GUILD_ID=0

# Public IPv4 address or hostname used in SSH and direct website links.
PUBLIC_HOST=YOUR_SERVER_IP
# Optional domain for automatic HTTPS: *.WEB_ROOT_DOMAIN must resolve to PUBLIC_HOST.
# Leave blank to issue direct http://PUBLIC_HOST:PORT web URLs.
WEB_ROOT_DOMAIN=

# 32 GB server example: reserve memory for the OS, Discord bot, Docker and other workloads.
# Adjust after checking actual VPS usage. Capacity is always detected at runtime too.
HOST_RESERVED_RAM_MB=6144
MIN_FREE_RAM_MB=2048
HOST_RESERVED_CPU_CORES=1.0

# Per-container maximum; these are enforced caps, not dedicated CPU cores.
MAX_INSTANCE_RAM_MB=8192
MAX_INSTANCE_CPU_CORES=4.0
VPS_RAM_MB=2048
VPS_CPU_CORES=1.0
WEB_RAM_MB=1024
WEB_CPU_CORES=1.0

# Public firewall ranges for customers.
SSH_PORT_START=22000
SSH_PORT_END=22999
WEB_PORT_START=8000
WEB_PORT_END=8999

DB_PATH=/app/data/hosting.sqlite3
WORK_DIR=/app/work
SITES_DIR=/app/caddy/sites
LOG_LEVEL=INFO
