# Create a Telegram bot with BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=PASTE_BOT_TOKEN_HERE
# Comma-separated Telegram numeric user IDs allowed to administer the host.
ADMIN_IDS=123456789
# Public IPv4 address or hostname reachable by customers.
PUBLIC_HOST=YOUR_SERVER_IP

# Optional wildcard domain with DNS *.hosting.example.com -> PUBLIC_HOST.
# Leave blank to return direct http://PUBLIC_HOST:PORT URLs for websites.
WEB_ROOT_DOMAIN=

# Capacity safeguards. These settings are intentionally conservative.
HOST_RESERVED_RAM_MB=8192
HOST_RESERVED_CPU_CORES=1.0
MIN_FREE_RAM_MB=2048

# Ports to publish. Allow these in the OS and provider firewalls.
SSH_PORT_START=22000
SSH_PORT_END=22999
WEB_PORT_START=8000
WEB_PORT_END=8999

# Limits for each website deployment.
WEB_MEMORY_MB=1024
WEB_CPU_CORES=1.0

DB_PATH=/app/data/hosting.sqlite3
